# Microservicio de WhatsApp Bot (Telas Real) para Railway
# Usa Baileys (WebSocket directo con WhatsApp): no necesita Chromium ni Puppeteer,
# por lo que la imagen es mucho más liviana y estable.

FROM node:22-slim

ENV NODE_ENV=production \
    WHATSAPP_BOT_PORT=3005 \
    WHATSAPP_AUTH_PATH=/data/baileys_auth

WORKDIR /app/services/whatsapp-bot

# Dependencias aisladas del bot (versiones fijadas en su package-lock.json)
COPY services/whatsapp-bot/package.json services/whatsapp-bot/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY services/whatsapp-bot/ ./

EXPOSE 3005

CMD ["node", "index.mjs"]
